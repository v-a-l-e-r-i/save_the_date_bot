# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token
BOT_USERNAME=YourExhibitionBot
# Comma-separated Telegram user IDs allowed to use admin commands
ADMIN_IDS=111111111,222222222

# Database. Examples:
#   SQLite (default, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
#   PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/save_the_date

# Exhibition
EXHIBITION_DATES=2026-10-28,2026-10-29,2026-10-30
EXHIBITION_TIMEZONE=Europe/Kyiv

# Reminders (days). 14 days after invite; 7 days before the FIRST exhibition date.
REMINDER_1_DAYS_AFTER_INVITE=14
REMINDER_2_DAYS_BEFORE_EVENT=7
# Hour of day (Europe/Kyiv) to run the daily reminder/report check
SCHEDULER_HOUR=10
SCHEDULER_MINUTE=0

# Email (for Excel report delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
REPORT_EMAIL_TO=client@example.com
# Set to true to also send the report automatically every day at SCHEDULER_HOUR
DAILY_AUTO_REPORT=false
